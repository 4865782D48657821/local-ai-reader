{
  "manifest_version": 3,
  "name": "Lokaler Reader",
  "version": "1.1",
  "description": "Artikel lokal extrahieren und mit Piper vorlesen",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Artikel lokal vorlesen",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lokaler-reader@example.local"
    }
  }
}
